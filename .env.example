# Copy to .env and fill in. .env is gitignored.

# Base URL of the Paperless-ngx instance, no trailing slash.
PAPERLESS_URL=http://localhost:8000

# API token: Paperless web UI -> Settings -> My Profile -> API Token (or generate one there).
PAPERLESS_TOKEN=

# Tesseract languages for OCR (each must be installed as tessdata). Default: deu+eng
#OCR_LANGUAGES=deu+eng
