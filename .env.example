# Copy to .env and fill in. .env is gitignored.

# Base URLs of the Paperless-ngx instance, no trailing slash. The local one is used when its port
# answers, else the remote one; either may be left out.
PAPERLESS_URL_LOCAL=http://localhost:8000
PAPERLESS_URL_REMOTE=

# The API token does NOT go here: store it in the OS credential store with
#   python -m pipeline.set_token
# (Paperless web UI -> Settings -> My Profile -> API Token). PAPERLESS_TOKEN in the environment
# still works for headless runs and wins over the keyring.

# Tesseract languages for OCR (each must be installed as tessdata). Default: deu+eng
#OCR_LANGUAGES=deu+eng
